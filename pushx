#!/data/data/com.termux/files/usr/bin/env python3
# -*- coding: utf-8 -*-
"""pushx — Bản kế thừa PatchX cổ điển (Legacy & Classic Toolkit Bridge).

Điểm vào kế thừa hỗ trợ toàn bộ các lệnh cổ điển của patchx và patchx_toolkit:
  1. Các lệnh Toolkit cổ điển:
     pushx doctor           Kiểm tra chẩn đoán môi trường & công cụ (classic toolkit)
     pushx run              Chạy toàn bộ quy trình thông minh (classic workflow)
     pushx package          Đóng gói phân phối toolkit + bộ patch chuẩn hóa
     pushx install-deps     Cài đặt phụ thuộc cần thiết cho hệ thống
     pushx apk-full         Quy trình APK hoàn chỉnh (decompile -> patch -> build -> sign)
     pushx webui            Khởi động giao diện WebUI trực quan
  2. Cầu nối toàn diện sang PatchX Core:
     pushx <LỆNH> ...       Chuyển tiếp tự động đến toàn bộ 60+ lệnh của patchx (phân 7 nhóm)
     pushx pipeline ...     Khởi chạy pipeline hợp nhất đa tầng
     pushx fast-patch ...   Vá DEX/AXML/ARSC in-place siêu tốc (<0.5s)
     pushx analyze ...      Phân tích ngữ nghĩa sâu & Security Gates (Zero-Workkey)
"""

import os
import sys

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, BASE_DIR)

TOOLKIT_COMMANDS = {
    "doctor", "run", "package", "install-deps", "apk-decompile",
    "apk-build", "apk-sign", "apk-patch", "apk-full", "apk-runtime",
    "plan-ui", "webui"
}


def print_banner():
    print("""============================================================================
   PUSHX — BẢN KẾ THỪA PATCHX CỔ ĐIỂN (LEGACY & COMPATIBILITY BRIDGE)
============================================================================
 Điểm vào kế thừa bảo tồn đầy đủ các tính năng cổ điển của patchx:
   • pushx doctor          Chẩn đoán môi trường, công cụ và bộ patch
   • pushx run             Chạy toàn bộ quy trình thông minh cổ điển
   • pushx package         Đóng gói phân phối toolkit
   • pushx install-deps    Cài đặt công cụ phụ thuộc hệ thống
   • pushx apk-full        Quy trình xử lý APK cổ điển trọn gói
   • pushx webui           Khởi động giao diện WebUI
   • pushx <LỆNH> ...      Gọi trực tiếp bất kỳ lệnh nào trong 7 nhóm PatchX
   • pushx -h / --help     Xem trợ giúp đầy đủ phân theo 7 nhóm tối ưu
============================================================================""")


def main(argv=None):
    args = list(sys.argv[1:] if argv is None else argv)
    if not args:
        print_banner()
        from patchx_core.cli import main as cli_main
        return cli_main(["--help"])

    cmd = args[0].lower()

    if cmd in ("-h", "--help") and len(args) == 1:
        print_banner()
        from patchx_core.cli import main as cli_main
        return cli_main(["--help"])

    # Xử lý các lệnh toolkit cổ điển nếu thuộc danh mục
    if cmd in TOOLKIT_COMMANDS:
        try:
            import patchx_toolkit
            return patchx_toolkit.main(args)
        except Exception as e:
            print(f"[pushx] Chuyển tiếp toolkit gặp lỗi: {e}, thử chuyển tiếp sang core...")

    # Chuyển tiếp toàn bộ các lệnh còn lại sang patchx core
    from patchx_core.cli import main as cli_main
    return cli_main(args)


if __name__ == "__main__":
    sys.exit(main())
